# NAPM 升级服务配置
NAPM_UPGRADE_PORT=18900
NAPM_UPGRADE_DB_PATH=./data/napm-upgrade.db
NAPM_UPGRADE_BACKUP_ROOT=/var/backups/napm
NAPM_UPGRADE_SKILLS_ROOT=/home/netinside/.openclaw/workspace/skills
NAPM_UPGRADE_PLUGIN_ROOT=/home/netinside/.openclaw/extensions/napm-openclaw-plugin
NAPM_UPGRADE_OPENCLAW_ROOT=/home/netinside/.npm-global/lib/node_modules/openclaw
NAPM_UPGRADE_FRONTEND_ROOT=/var/www/napm-admin
NAPM_UPGRADE_PUBLIC_KEY_PATH=./config/public.pem
NAPM_UPGRADE_BACKUP_RETENTION=5
NAPM_UPGRADE_LOCK_DIR=/tmp
NAPM_UPGRADE_SMOKE_TIMEOUT_MS=30000
NAPM_UPGRADE_OPENCLAW_RESTART_TIMEOUT_MS=60000
NAPM_UPGRADE_LOG_LEVEL=info
# AES-256-GCM 升级包加密密钥（64 位 hex = 32 字节）。
# 不设置则不启用包加密（明文 ZIP）。
# 生产环境必须换为独立生成的随机密钥，严禁泄露。
NAPM_PACKAGE_ENCRYPTION_KEY=5e78e88194e6bd4cb30723e01cf83b906d2957407194a9cae72ad35755d24b38
