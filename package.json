{
  "name": "gaiop-package-tool",
  "version": "1.0.0",
  "description": "GAIOP 升级包打包工具",
  "main": "electron/main.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test test/**/*.test.js",
    "cleanup:retention": "node src/retention-cleanup.js",
    "db:init": "node src/database/init.js",
    "package:gui": "node tools/package-gui.js",
    "electron": "electron .",
    "build:win": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.gaiop.package-tool",
    "productName": "GAIOP Package Tool",
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false,
    "files": [
      "electron/**/*",
      "tools/package-gui.js",
      "tools/package.js",
      "config/",
      "node_modules/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "tools/package-gui.ico"
    },
    "portable": {
      "artifactName": "GAIOP-Package-Tool.exe"
    }
  },
  "keywords": [
    "gaiop",
    "upgrade",
    "package",
    "gui"
  ],
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^11.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "proper-lockfile": "^4.1.2",
    "semver": "^7.6.3",
    "uuid": "^10.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.3"
  }
}
