NODE_ENV=production
GAIOP_UPGRADE_HOST=127.0.0.1
GAIOP_UPGRADE_INTERNAL_TOKEN=replace-with-a-random-server-owned-token
NAPM_UPGRADE_PORT=18900
NAPM_UPGRADE_DB_PATH=/var/lib/gaiop/upgrade/upgrade.db
NAPM_UPGRADE_BACKUP_ROOT=/var/backups/gaiop/upgrade
NAPM_UPGRADE_PACKAGE_STAGING_ROOT=/var/lib/gaiop/upgrade/staging
NAPM_UPGRADE_LOCK_DIR=/run/gaiop-upgrade
NAPM_UPGRADE_SKILLS_ROOT=/home/netinside/.openclaw/workspace/skills
NAPM_UPGRADE_PLUGIN_ROOT=/home/netinside/.openclaw/extensions/napm-openclaw-plugin
NAPM_UPGRADE_OPENCLAW_ROOT=/home/netinside/.npm-global/lib/node_modules/openclaw
NAPM_UPGRADE_FRONTEND_ROOT=/opt/gaiop/admin/dist
NAPM_UPGRADE_PUBLIC_KEY_PATH=/opt/gaiop/upgrade/config/public.pem
NAPM_UPGRADE_OPENCLAW_RESTART_HELPER=/usr/local/libexec/gaiop-upgrade-restart-openclaw
NAPM_UPGRADE_OPENCLAW_HEALTH_URL=http://127.0.0.1:18789/health
NAPM_UPGRADE_FRONTEND_HEALTH_URL=http://127.0.0.1:3000/api/health
NAPM_UPGRADE_RUNTIME_OWNER=netinside
NAPM_UPGRADE_RUNTIME_GROUP=netinside
NAPM_UPGRADE_FRONTEND_OWNER=gaiop
NAPM_UPGRADE_FRONTEND_GROUP=gaiop
NAPM_UPGRADE_BACKUP_RETENTION=5
GAIOP_UPGRADE_RETENTION_AUTO_DELETE=false
GAIOP_UPGRADE_RETENTION_MAX_ITEMS=100
GAIOP_UPGRADE_RETENTION_AUDIT_LOG=/var/lib/gaiop/upgrade/retention-cleanup-audit.jsonl
GAIOP_UPGRADE_RETENTION_LOCK_PATH=/run/gaiop-upgrade-retention/cleanup.lock
GAIOP_UPGRADE_FAILED_PACKAGE_RETENTION_DAYS=7
GAIOP_UPGRADE_STAGING_RETENTION_HOURS=24
GAIOP_UPGRADE_BACKUP_RETENTION_DAYS=90
GAIOP_UPGRADE_BACKUP_MIN_USABLE_GROUPS=5
GAIOP_UPGRADE_BACKUP_MIN_USABLE_GROUPS=5
